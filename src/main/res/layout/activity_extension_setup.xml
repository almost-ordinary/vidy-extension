<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070A"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Title Badge -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FRAMETUNE TV EXTENSION"
        android:textColor="#E50914"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.15" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Vidy Embed Player"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxWidth="520dp"
        android:gravity="center"
        android:text="100% on-device streaming extension. Inbuilt multi-server switching, audio tracks, and OpenSubtitles selection directly on your TV."
        android:textColor="#9CA3AF"
        android:textSize="14sp" />

    <!-- Status Indicator -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="#161B22"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvStatusDot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● "
            android:textColor="#22C55E"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvServerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Local Loopback Server: http://127.0.0.1:8910"
            android:textColor="#E5E7EB"
            android:textSize="13sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Action Buttons with D-pad focus -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnLinkFrameTune"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#E50914"
            android:focusable="true"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp"
            android:text="🔗 Copy Addon Link"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTestPlayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="#1F2937"
            android:focusable="true"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp"
            android:text="▶ Test Vidy Player"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Add 'http://127.0.0.1:8910' in FrameTune TV > Extension Sidebar to enable."
        android:textColor="#6B7280"
        android:textSize="12sp" />

</LinearLayout>

